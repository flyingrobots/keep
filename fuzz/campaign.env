# Reviewed cargo-fuzz tool boundary.
CARGO_FUZZ_VERSION=0.13.2
FUZZ_TOOLCHAIN=nightly-2026-07-24

# Shared libFuzzer resource bounds.
FUZZ_INPUT_TIMEOUT_SECONDS=5
FUZZ_MAX_INPUT_BYTES=1048576
FUZZ_RSS_LIMIT_MB=1024

# Campaign-specific exploration budgets.
FUZZ_SMOKE_SECONDS_PER_TARGET=15
FUZZ_SCHEDULED_SECONDS_PER_TARGET=600
FUZZ_CMIN_SECONDS_PER_TARGET=120

# Retained derived-corpus bounds.
FUZZ_CORPUS_MAX_FILES=20000
FUZZ_CORPUS_MAX_BYTES=536870912

# Finite GitHub artifact retention.
FUZZ_SMOKE_FAILURE_RETENTION_DAYS=14
FUZZ_SCHEDULED_FAILURE_RETENTION_DAYS=30
FUZZ_CORPUS_RETENTION_DAYS=14
